{
  "name": "hoku",
  "version": "0.1.0",
  "private": true,
  "description": "HOKU — multi-tenant website platform for local small businesses (Next.js + Supabase + Stripe + Vercel)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "next": "15.5.19",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "22.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
