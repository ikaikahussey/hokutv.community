# ---------------------------------------------------------------------------
# HOKU environment — copy to `.env` (or `.env.local`) and fill in.
# NEVER commit real values. See README for how each is obtained.
# ---------------------------------------------------------------------------

# Supabase (Postgres + Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (plain — not Connect; see build prompt §9)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CUSTOM_DOMAIN=

# Vercel (custom-domain automation, Phase 5)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Anthropic (ad-copy suggestions, Phase 8)
ANTHROPIC_API_KEY=

# Domain architecture (build prompt §3) — load-bearing security boundary
APP_BASE_DOMAIN=hoku.com
TENANT_BASE_DOMAIN=hokusites.com
ADS_HOST=ads.hoku.com

# --- Acquisition funnel (Phases A–D) ---------------------------------------
# Compliance posture for this funnel must be reviewed by counsel before any
# real send — see COUNSEL.md. These keys gate nothing until that review.
GOOGLE_PLACES_API_KEY=
LOB_API_KEY=
PROVISIONAL_HOST=preview.hoku.com
CLAIM_BASE_URL=https://hoku.com/claim
HOKU_RETURN_LINE1=
HOKU_RETURN_CITY=
HOKU_RETURN_STATE=
HOKU_RETURN_ZIP=
MAX_PER_BATCH=50
